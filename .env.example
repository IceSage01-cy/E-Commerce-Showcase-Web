R2_PUBLIC_URL=https://pub-04705f165be34a27b3a2b6362ceb1f8f.r2.dev


QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

