APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e-commerce
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true in production (Render) so the session cookie is only ever sent
# over HTTPS. Leaving this unset means it's not forced, which is fine on
# localhost but shouldn't be left that way on a live deployment.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=public
R2_ACCESS_KEY_ID=f81dae071b9465159033df240b78c458
R2_SECRET_ACCESS_KEY=1e3b63b1e6913eaa925eb6c7357e7428041157b618f5b130aaf21aa7c090c22c
